# Copy to .env. The defaults follow the gpx-soft-delete-dev instance.

# The osm-dev instance to follow: its replication feed and its full dump
FEED_URL=https://replication-gpx-soft-delete-dev.rub21.com/gpx/
DUMP_URL=https://replication-gpx-soft-delete-dev.rub21.com/gps/gpx-planet-latest.osm.bz2
INTERVAL=60

# gpxsync branch or commit built into the consumer image. Rebuild with make up after changing it.
# GPXSYNC_REF=main

# Container name prefix and the local Martin port
NAME=gpxtiles
MARTIN_PORT=3100

# Server only, with PROXY=1: the hostname Traefik routes to Martin
# TILES_DOMAIN_NAME=tiles-gpx-soft-delete-dev.example.org
